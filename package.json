{
  "name": "glideslope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:functions": "node scripts/build-functions.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "create-owner": "tsx --env-file=.env.local scripts/create-owner.mts",
    "llm-worker": "tsx --env-file=.env.local scripts/llm-worker.mts",
    "llm-eval": "tsx --env-file=.env.local tests/llm-eval/run.ts",
    "e2e:setup": "tsx --env-file=.env.local scripts/e2e-setup.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "supabase": true,
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
